{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkOrder",
  "description": "Schema for FPF Architecture Work Order issued by DEV Commander",
  "type": "object",
  "required": [
    "order_version",
    "kind",
    "task_id",
    "objective",
    "boundaries",
    "acceptance_criteria",
    "target_branch"
  ],
  "properties": {
    "order_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "WORK_ORDER" },
    "task_id": { "type": "string" },
    "objective": { "type": "string" },
    "boundaries": {
      "type": "object",
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target_branch": { "type": "string" }
  }
}
