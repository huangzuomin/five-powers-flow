{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevHandoff",
  "description": "Schema for FPF DEV Hand-off card",
  "type": "object",
  "required": [
    "handoff_version",
    "kind",
    "task_id",
    "baseline_sha",
    "tested_code_sha",
    "pr_url",
    "scope",
    "changed_files",
    "dev_checks",
    "not_run",
    "known_risks",
    "state",
    "author"
  ],
  "properties": {
    "handoff_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "DEV_HANDOFF"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "tested_code_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "handoff_evidence_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "pr_url": {
      "type": "string",
      "format": "uri"
    },
    "scope": {
      "type": "string",
      "minLength": 5
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dev_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "environment": {
            "type": "string"
          },
          "raw_log_anchor": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of untested areas/boundaries. If empty, not_run_exemption_justification is mandatory.",
      "minItems": 1
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "DEV_READY_FOR_QA",
        "DEV_BLOCKED"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"
    }
  },
  "additionalProperties": false
}
