{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceManifest",
  "description": "Schema for FPF 32-Item Evidence Manifest (EVID-01 to EVID-32)",
  "type": "object",
  "required": [
    "manifest_version",
    "task_id",
    "profile",
    "items"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "enum": [1]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": [
        "PROFILE-LIBRARY",
        "PROFILE-API-DB",
        "PROFILE-FULLSTACK",
        "PROFILE-REWORK",
        "Library",
        "API-DB",
        "Full-Stack",
        "Rework"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVID-(0[1-9]|[12][0-9]|3[0-2])(-[A-Z0-9_-]+)?$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "NOT_APPLICABLE"]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
