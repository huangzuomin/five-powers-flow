{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPF bootstrap role configuration",
  "type": "object",
  "required": [
    "registry_version",
    "project_id",
    "mode",
    "roles"
  ],
  "properties": {
    "registry_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 2
    },
    "mode": {
      "enum": [
        "api",
        "manual"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "role",
          "status",
          "prompt",
          "session_id"
        ],
        "properties": {
          "role": {
            "enum": [
              "orchestrator",
              "dev_lead",
              "qa_lead",
              "scribe"
            ]
          },
          "status": {
            "const": "CONFIGURED_NOT_VERIFIED"
          },
          "prompt": {
            "type": "string",
            "pattern": "^\\.fpf/prompts/[a-z_]+\\.md$"
          },
          "session_id": {
            "type": "null"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
