{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QaResult",
  "description": "Schema for FPF QA Verdict card",
  "type": "object",
  "required": [
    "result_version",
    "kind",
    "task_id",
    "tested_sha",
    "runner_sha",
    "qa_contract_sha",
    "environment",
    "verdict",
    "checks",
    "evidence_manifest_sha256",
    "findings",
    "next_action"
  ],
  "properties": {
    "result_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "QA_RESULT" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "tested_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runner_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "qa_contract_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "environment": { "type": "string", "minLength": 5 },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "INVALID_TEST"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exit_code"],
        "properties": {
          "name": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      },
      "minItems": 1
    },
    "evidence_manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "findings": {
      "type": "object",
      "properties": {
        "p0": { "type": "array", "items": { "type": "string" } },
        "p1": { "type": "array", "items": { "type": "string" } },
        "p2": { "type": "array", "items": { "type": "string" } }
      }
    },
    "next_action": { "type": "string" }
  }
}
