#!/usr/bin/env bash
# Five-Powers-Flow (FPF) Pre-Push Hook Template
# Copy this file to .git/hooks/pre-push and make it executable (chmod +x .git/hooks/pre-push)
#
# Mechanically prevents DEV branches from pushing any commit that touches PROJECT-MAP.md.

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Branch deletion, skip
        continue
    fi

    # Check against origin/main or baseline
    base_ref="origin/main"
    if ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
        base_ref="main"
    fi

    touched_map=$(git diff --name-only "$base_ref...$local_sha" 2>/dev/null | grep -i "PROJECT-MAP.md")
    if [ -n "$touched_map" ]; then
        echo ""
        echo "======================================================================"
        echo "[FPF PRE-PUSH BLOCKED] Anti-Tamper Violation Detected!"
        echo "The commit you are attempting to push modifies: $touched_map"
        echo "Under Five-Powers-Flow protocol, PROJECT-MAP.md can ONLY be updated by"
        echo "the Project Map Scribe via independent document PR backed by QA PASS."
        echo "Self-marking by DEV branches is strictly prohibited by law."
        echo "======================================================================"
        echo ""
        exit 1
    fi
done

exit 0
